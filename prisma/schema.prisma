generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(cuid())
  name          String?
  email         String?     @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  itineraries   Itinerary[]
  bookings      Booking[]
  createdAt     DateTime    @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Destination {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  zone        String
  type        String
  emoji       String     @default("📍")
  description String     @db.Text
  lat         Float?
  lng         Float?
  duration    Float      @default(2)
  price       String     @default("Gratis")
  difficulty  String     @default("media")
  schedule    String?
  openDays    String?
  bestTime    String?
  idealSeason String?
  warnings    String?    @db.Text
  howToGet    String?    @db.Text
  tips        String[]
  tags        String[]
  activities  Activity[]
  createdAt   DateTime   @default(now())
}

model Activity {
  id            String      @id @default(cuid())
  title         String
  description   String      @db.Text
  price         Float
  duration      Float
  type          String
  maxGroupSize  Int         @default(10)
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  bookings      Booking[]
  createdAt     DateTime    @default(now())

  @@index([destinationId])
}

model Itinerary {
  id         String    @id @default(cuid())
  userId     String?
  title      String
  days       Int       @default(3)
  budget     String    @default("moderado")
  traveler   String    @default("Solo/Sola")
  interests  String[]
  activities Json // JSONB: { day: number, destinationIds: string[], notes: string }[]
  totalCost  Float?
  shareToken String?   @unique @default(cuid())
  user       User?     @relation(fields: [userId], references: [id])
  bookings   Booking[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Booking {
  id            String     @id @default(cuid())
  userId        String?
  activityId    String?
  itineraryId   String?
  stripeSession String?    @unique
  status        String     @default("pending") // pending | paid | cancelled
  totalAmount   Float
  customerEmail String?
  customerName  String?
  notes         String?
  user          User?      @relation(fields: [userId], references: [id])
  activity      Activity?  @relation(fields: [activityId], references: [id])
  itinerary     Itinerary? @relation(fields: [itineraryId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model TourQuote {
  id            String   @id @default(cuid())
  quoteNumber   String   @unique
  tourName      String
  tourSlug      String
  tourDate      String
  adults        Int      @default(1)
  children      Int      @default(0)
  totalAmount   Int
  customerName  String
  customerEmail String
  customerPhone String?
  notes         String?
  lineItems     Json? // [{tourSlug,tourName,tourDate,adults,children,subtotal}]
  packageItems  Json? // [{habitacion,hotel,noches,habitaciones,precioPorNoche,checkin,checkout,subtotal}]
  /// Items sueltos que no son recorrido ni hotel: la comida, el transporte, el
  /// guía privado. Ver `src/lib/admin/extras.ts`.
  /// Columna propia y NULLABLE a propósito: `npm start` corre
  /// `prisma db push --accept-data-loss` en producción y una columna
  /// obligatoria sobre filas existentes tumba el despliegue.
  extraItems    Json? // [{concepto,detalle,cantidad,precioUnitario,incluido,costoUnitario,subtotal}]
  status        String   @default("borrador") // borrador | enviada | aceptada | expirada
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([customerEmail])
  @@index([status])
}

// Carrito abandonado: el cliente eligió tour/fecha y dejó su correo pero no pagó.
// Un cron manda 1-2 correos de recuperación con un link que restaura la reserva.
/// Correos capturados por el recomendador o el itinerario, con el contexto de
/// lo que la persona pidió. Hasta ahora los leads solo se guardaban en una hoja
/// de Google y nadie les volvía a escribir: se capturaba el correo y ahí moría.
/// Guardar la recomendación permite que la secuencia hable de SU tour, no de
/// "nuestros tours".
model Lead {
  id     String @id @default(cuid())
  email  String
  fuente String @default("Recomendador") // Recomendador | Itinerario 3 días | Blog | Destino: X

  // Contexto del recomendador (todo opcional: otras fuentes no lo tienen)
  grupo          String? // pareja, familia, amigos…
  dias           String?
  origen         String? // ciudad de la que viene
  intereses      String[] @default([])
  tourPrincipal  String? // slug
  tourSecundario String? // slug
  paquete        String? // slug

  // Estado de la secuencia
  emailsSent  Int       @default(0)
  lastEmailAt DateTime?
  status      String    @default("activo") // activo | convertido | baja | terminado
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([email, fuente])
  @@index([status, emailsSent])
}

/// Eventos del embudo. Antes solo se escribían a stdout (Railway los rota), así
/// que no había forma de contar nada: ni tasa de conversión, ni cuántos llegan
/// al pago, ni desde qué página. Aquí quedan para poder medirlo.
model TrackEvent {
  id        String   @id @default(cuid())
  event     String // TOUR_PAGE_VIEW, CHECKOUT_STARTED, PAGO_FALLIDO, BOOKING_CONFIRMED…
  sid       String? // sesión del visitante (sessionStorage), para seguir su recorrido
  path      String?
  tourSlug  String?
  amount    Int? // MXN, cuando el evento tiene monto
  device    String? // movil | escritorio
  referrer  String? // de dónde llegó
  data      Json? // el resto del payload, sin esquema fijo
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([sid])
  @@index([tourSlug])
}

model AbandonedCart {
  id            String    @id @default(cuid())
  token         String    @unique @default(cuid()) // link de recuperación
  tourId        String
  tourSlug      String
  tourName      String
  tourDate      String
  adults        Int       @default(1)
  childrenMid   Int       @default(0)
  childrenSmall Int       @default(0)
  promoCode     String?
  promoDiscount Int       @default(0)
  total         Int
  customerEmail String
  customerPhone String?
  // open      → vivo, recibe recordatorios automáticos
  // recovered → estado fósil (ya nada lo escribe); se trata como "open"
  // manual    → lo lleva Manolo en persona: EXCLUIDO de todo envío automático
  // converted → ya reservó
  // expired   → el tour pasó, o el carrito superó los 14 días
  status        String    @default("open")
  // Carrito completo en JSON cuando la cotización trae VARIOS recorridos.
  // Nullable a propósito: `npm start` corre `prisma db push --accept-data-loss`
  // en producción, y una columna obligatoria sobre filas existentes tira el
  // despliegue. Las columnas planas de arriba siguen siendo el ancla del cron y
  // del correo, y se llenan con el primer recorrido.
  carritoJson   String?
  emailsSent    Int       @default(0)
  lastEmailAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([customerEmail])
  @@index([status])
}

model TourBooking {
  id                    String    @id @default(cuid())
  confirmationNumber    String    @unique
  tourId                String
  tourName              String
  tourSlug              String
  tourDate              String
  adults                Int       @default(1)
  children              Int       @default(0)
  totalAmount           Int
  promoCode             String?
  promoDiscount         Int       @default(0)
  stripePaymentIntentId String?   @unique // evita 2 reservas para el mismo pago (carrera cliente/webhook)
  customerName          String
  customerEmail         String
  customerPhone         String?
  notes                 String?
  lineItems             Json? // [{tourSlug,tourName,tourDate,adults,childrenMid,childrenSmall,subtotal}]
  packageItems          Json? // [{habitacion,hotel,noches,habitaciones,precioPorNoche,checkin,checkout,subtotal}]
  /// Items sueltos que no son recorrido ni hotel (comida, transporte, guía
  /// privado). Mismo formato que en TourQuote: ver `src/lib/admin/extras.ts`.
  extraItems            Json? // [{concepto,detalle,cantidad,precioUnitario,incluido,costoUnitario,subtotal}]
  depositoPagado        Int       @default(0)
  // Control de pagos al proveedor de servicios (lanchero, guía, transporte).
  // null = sin marcar · true = ya le pagué · false = marcado como NO pagado.
  // Campos opcionales a propósito: `prisma db push` corre en cada arranque de
  // Railway y una columna obligatoria sobre filas existentes tumba el deploy.
  pagoProveedor         Boolean?
  pagoProveedorMonto    Int       @default(0)
  pagoProveedorFecha    DateTime?
  pagoProveedorNota     String?
  status                String    @default("pending")
  /// Quién sale a guiar esta reserva. Texto libre a propósito: los guías
  /// cambian con la temporada y una tabla aparte obligaría a darlos de alta
  /// antes de poder asignarlos. El panel ofrece los nombres ya usados.
  guia                  String?
  /// En qué idioma sale el tour: es | en. No es el idioma en que escribe el
  /// cliente (eso vive en el `_meta` de lineItems), sino en cuál tiene que
  /// guiar quien sale: alguien puede escribir en español y pedirlo en inglés.
  idiomaTour            String    @default("es")
  /// Por dónde entró la reserva: web | whatsapp | telefono | walkin | ota.
  /// GA4 registraba 4 compras mientras el panel mostraba once: sin este campo
  /// no se puede saber si falta medición o si la venta se cerró por chat, y
  /// sin saberlo no se puede decidir dónde invertir.
  /// Con `@default` a propósito: `prisma db push` corre en cada arranque de
  /// Railway y una columna obligatoria sobre filas existentes tumba el deploy.
  /// Las reservas anteriores a este campo quedan como "web": es el valor que
  /// más probablemente les corresponde, pero conviene revisarlas a mano.
  origen                String    @default("web")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([customerEmail])
  @@index([tourDate])
  @@index([status])
  @@index([origen])
}

model BlogPost {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  metaTitle         String? // SEO title (max 60 chars)
  metaDescription   String   @db.Text
  focusKeyword      String
  secondaryKeywords String[]
  excerpt           String   @db.Text
  content           String   @db.Text
  authorBio         String?  @db.Text // HTML block — bio de Manolo Covarrubias
  schemaMarkup      String?  @db.Text // JSON-LD Article+Person
  coverImageUrl     String?
  coverImageAlt     String?
  coverImageFile    String? // nombre de archivo slug-based
  internalLinks     String[] // slugs de posts relacionados
  externalSources   String[] @default([]) // fuentes citadas
  tags              String[]
  readingTime       Int      @default(5)
  published         Boolean  @default(true)
  publishedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([slug])
  @@index([publishedAt])
  @@index([tags])
}

/// Evidencia del pago al proveedor: el PDF o la captura de la transferencia.
/// Vive en tabla APARTE (no en TourBooking) a propósito: el panel hace
/// `findMany` de TODAS las reservas y si los bytes colgaran de TourBooking
/// cada carga del listado se traería los archivos completos.
/// Se guarda en Postgres porque Railway no tiene disco persistente: lo que se
/// escriba en el contenedor se borra en el siguiente despliegue.
model PagoProveedorEvidencia {
  id            String   @id @default(cuid())
  bookingId     String
  nombreArchivo String
  tipoMime      String
  tamanoBytes   Int
  datos         Bytes
  createdAt     DateTime @default(now())

  @@index([bookingId])
}

/// Lo que a NOSOTROS nos cuesta operar cada recorrido. Sin esto el panel sabe
/// perfectamente cuánto se cobró y nada de cuánto se ganó: el margen se
/// calculaba de cabeza, tour por tour, cada vez que había que decidir un
/// descuento.
///
/// Un renglón por recorrido (`tourSlug` es la llave: el catálogo vive en
/// `src/lib/tours.ts`, aquí solo van los costos). El desglose se guarda en JSON
/// porque los conceptos cambian por tour —lancha en Tamul, entradas en Micos,
/// gasolina en el RZR— y no hay una lista fija que valga para los diez.
///
/// Cada concepto dice si se paga POR PERSONA o FIJO POR SALIDA. Esa distinción
/// es la que da la respuesta real: el costo fijo se reparte entre más gente, y
/// por eso un grupo grande aguanta un descuento que uno de dos no aguanta.
model TourCosto {
  tourSlug  String   @id
  conceptos Json // [{concepto, monto, tipo: "persona" | "fijo"}]
  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Los precios de los items que no son recorrido: la comida, el transporte, las
/// bebidas. Lo que se le COBRA al cliente y lo que a nosotros nos CUESTA.
///
/// Existe para que estos números dejen de vivir en el código. Estaban puestos a
/// mano (la comida a $200) y cambiarlos cuando sube el proveedor obligaba a
/// tocar el repositorio: un precio que solo un programador puede mover es un
/// precio que se queda viejo.
///
/// Son SUGERENCIAS, no reglas: rellenan el item al crearlo y después se pisan
/// cotización por cotización. Lo que se le prometió a un cliente vive en su
/// cotización, no aquí, así que subir un precio nunca reescribe el pasado.
model PrecioExtra {
  concepto   String   @id
  detalle    String?
  precio     Int      @default(0) // lo que se le cobra al cliente, por unidad
  costo      Int      @default(0) // lo que nos cuesta a nosotros, por unidad
  porPersona Boolean  @default(true)
  orden      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Lo que cobra un PROVEEDOR de servicios por llevar al grupo, todo incluido
/// (transporte, guía, desayuno y entradas) y por persona.
///
/// Es un modelo de costo distinto al propio y por eso vive aparte de
/// `TourCosto`: aquí no hay "por persona + fijo por salida" que separar, hay
/// una tarifa por cabeza que BAJA conforme crece el grupo. Con 2 personas la
/// Ruta Surrealista cuesta $1,100 cada una; con 20, $850. Mezclar los dos
/// modelos en una sola tabla obligaría a que cada consulta supiera cuál es.
///
/// La llave es el recorrido, y cuando el mismo recorrido tiene dos versiones
/// con precio distinto —la Ruta Acuática se cotiza aparte según se vaya a las
/// Siete Cascadas o a Tamasopo— se le pega la variante: `<slug>::<varianteId>`.
model TarifaProveedor {
  clave     String   @id
  tourSlug  String
  variante  String?
  nombre    String
  tarifas   Json // [{personas, precio}] — escalones de 2 a 20
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Curso "Turismo con IA" (funnel /curso) ──────────────────────────────────
// Un solo registro por persona: lead, registrado al taller, checkout iniciado
// y alumno son ESTADOS del mismo renglón, no tablas distintas. Los correos de
// las secuencias A/B/C/D/W se marcan por ID en `correosEnviados` y los manda
// /api/cron/curso — la condición es siempre "este correo no se le ha mandado",
// reclamada de forma atómica (misma lección que el correo de bienvenida del
// recomendador: preguntar-y-luego-escribir deja ventana para mandarlo doble).
model CursoLead {
  id          String  @id @default(cuid())
  email       String  @unique
  nombre      String?
  whatsapp    String?
  tipoNegocio String? // Agencia | Guía | Operador | Hotel | Otro
  ciudad      String?
  origen      String  @default("landing") // landing | webinar | whatsapp | checkout

  webinar Boolean @default(false) // registrado al taller gratuito del 10 sep

  correosEnviados String[] @default([]) // IDs: A1..A7, B1..B3, C1..C14, D1..D4, W1..W3

  checkoutIniciadoAt DateTime?
  compro             Boolean   @default(false)
  comproAt           DateTime?
  montoMxn           Int?
  stripeSessionId    String?

  status    String   @default("activo") // activo | baja
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, compro])
}

/// Una descarga de un workbook del taller.
///
/// El workbook se reparte por el grupo de WhatsApp, con UNA sola liga para
/// todos, así que la descarga no puede saber quién es quien la pide. Lo que sí
/// se puede medir es cuántos aparatos distintos la pidieron, y eso ya contesta
/// la pregunta que importa: de los que se registraron, ¿cuántos se llevaron el
/// cuaderno?
///
/// No se guarda la IP: se guarda un hash de IP + navegador. Sirve para no
/// contar cinco veces a quien lo abre cinco veces, y no sirve para nada más.
model CursoDescarga {
  id        String   @id @default(cuid())
  noche     Int // 1 | 2 | 3
  huella    String // sha256(ip + user-agent + sal). Nunca la IP en claro.
  createdAt DateTime @default(now())

  @@index([noche, createdAt])
  @@index([noche, huella])
}

// ── Bitácora del panel ──────────────────────────────────────────────────────
// Quién hizo qué, y cuándo. Solo la ve el dueño (rol "dueno" en
// src/lib/admin/usuarios.ts). Se escribe desde `registrarEnBitacora()`, que
// NUNCA lanza excepción: si la bitácora falla, la reserva se guarda igual.
// `detalle` guarda el antes/después de cada campo que cambió, ya traducido a
// español, para poder leer el renglón sin abrir la base de datos.
model Bitacora {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  usuario String // "erick" — el usuario con el que entró
  nombre  String // "Erick" — cómo se muestra
  rol     String // dueno | socio | operacion | sistema

  accion     String // creó | modificó | eliminó | envió | entró | intento fallido
  entidad    String // reserva | cotización | precios | comprobante | panel
  referencia String? // folio visible: HP-XXXX, COT-XXXX
  resumen    String // renglón legible tal cual se muestra en el panel
  detalle    Json? // [{campo, antes, despues}] cuando fue una modificación

  @@index([createdAt])
  @@index([usuario, createdAt])
}

// ── Gastos del corte, capturados a mano ─────────────────────────────────────
// Lo que no cuelga de ninguna reserva: gasolina de la camioneta, sueldos,
// publicidad, renta, una refacción. Sin esto el corte enseña lo que dejan las
// salidas, no lo que gana el negocio.
//
// `fecha` es YYYY-MM-DD, igual que `tourDate`: así el corte por día y por
// semana no pelea con zonas horarias.
model GastoCorte {
  id        String   @id @default(cuid())
  fecha     String
  concepto  String
  monto     Int
  nota      String?
  /// Si el costo es de UNA salida (el lanchero de los Ruiz), aquí va el id de
  /// su reserva y el corte lo resta a esa reserva, no al día. Vacío = gasto
  /// general del periodo (gasolina, sueldos, publicidad).
  /// Sin llave foránea a propósito: si la reserva se borra, el gasto no debe
  /// desaparecer del corte de un mes que ya se cerró.
  reservaId String?
  /// Quién lo capturó, para poder preguntarle.
  creadoPor String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fecha])
  @@index([reservaId])
}
