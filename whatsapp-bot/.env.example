# ════════════════════════════════════════════════════
# Bot de WhatsApp — Tours Huasteca Potosina
# Copia este archivo como ".env" y llena los valores
# ════════════════════════════════════════════════════

# Claude (Anthropic) — requerido
ANTHROPIC_API_KEY=sk-ant-...

# URL del sitio (Next.js) donde viven los endpoints /api/bot/*
# Local: http://localhost:3000  ·  Producción: https://www.huasteca-potosina.com
SITE_API_URL=http://localhost:3000

# Token compartido con el sitio (DEBE ser idéntico a AGENT_API_TOKEN del sitio)
AGENT_API_TOKEN=

# Número de WhatsApp del dueño para alertas de escalación (solo dígitos: 52XXXXXXXXXX)
OWNER_WHATSAPP_NUMBER=

# A quién responde el bot (corre en número personal):
#   strangers = solo a desconocidos / no guardados (recomendado)
#   all       = a todos
RESPOND_MODE=strangers
# Números que SIEMPRE reciben respuesta aunque estén guardados (pruebas). Coma-separados.
ALWAYS_RESPOND_NUMBERS=

# Modelo. Haiku es el barato ($1 / $5 por millón de tokens) y es el que usamos.
# claude-sonnet-5 cuesta 3x más; solo vale la pena si el bot empieza a fallar
# en seguir el embudo.
BOT_MODEL=claude-haiku-4-5

# ESPERA POR RÁFAGA. El cliente manda varios mensajes seguidos; el bot espera a
# que deje de escribir y contesta UNA vez a todo junto.
#   MESSAGE_DEBOUNCE_MS     cada mensaje nuevo reinicia este reloj
#   MESSAGE_DEBOUNCE_MAX_MS tope duro desde el primer mensaje de la ráfaga
MESSAGE_DEBOUNCE_MS=15000
MESSAGE_DEBOUNCE_MAX_MS=90000

# Cuando el dueño escribe a mano en un chat, el bot se calla ese rato.
HUMAN_TAKEOVER_MS=300000

# Datos de pago que da el bot (transferencia + OXXO)
BANK_NAME=
BANK_TITULAR=
BANK_CLABE=
OXXO_REFERENCIA=

# Sitio del hotel, para consultar disponibilidad de habitaciones (solo lectura)
HOTEL_API_URL=https://www.paraisoencantado.com

# (Opcional, Railway/Docker) ruta a Chromium si no usas el de puppeteer
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
