# ════════════════════════════════════════════════════
# Bot de WhatsApp — Tours Huasteca Potosina
# Copia este archivo como ".env" y llena los valores
# ════════════════════════════════════════════════════

# Claude (Anthropic) — requerido
ANTHROPIC_API_KEY=sk-ant-...

# URL del sitio (Next.js) donde viven los endpoints /api/bot/*
# Local: http://localhost:3000  ·  Producción: https://www.huasteca-potosina.com
SITE_API_URL=http://localhost:3000

# Token compartido con el sitio (DEBE ser idéntico a AGENT_API_TOKEN del sitio)
AGENT_API_TOKEN=

# Número de WhatsApp del dueño para alertas de escalación (solo dígitos: 52XXXXXXXXXX)
OWNER_WHATSAPP_NUMBER=

# A quién responde el bot (corre en número personal):
#   strangers = solo a desconocidos / no guardados (recomendado)
#   all       = a todos
RESPOND_MODE=strangers
# Números que SIEMPRE reciben respuesta aunque estén guardados (pruebas). Coma-separados.
ALWAYS_RESPOND_NUMBERS=

# (Opcional) modelo, debounce y pausa por humano
BOT_MODEL=claude-haiku-4-5-20251001
MESSAGE_DEBOUNCE_MS=2500
HUMAN_TAKEOVER_MS=3600000

# (Opcional, Railway/Docker) ruta a Chromium si no usas el de puppeteer
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
