# ════════════════════════════════════════════════════
# Bot de WhatsApp — Tours Huasteca Potosina
# Copia este archivo como ".env" y llena los valores
# ════════════════════════════════════════════════════

# Claude (Anthropic) — requerido
ANTHROPIC_API_KEY=sk-ant-...

# URL del sitio (Next.js) donde viven los endpoints /api/bot/*
# Local: http://localhost:3000  ·  Producción: https://www.huasteca-potosina.com
SITE_API_URL=http://localhost:3000

# Token compartido con el sitio (DEBE ser idéntico a AGENT_API_TOKEN del sitio)
AGENT_API_TOKEN=

# WhatsApp del dueño (solo dígitos: 52XXXXXXXXXX). Es el ÚNICO que recibe los
# avisos (comprobantes, escalaciones, fallas) y el único que puede mandarle
# comandos al bot por mensaje directo (/confirma, /pausa, /reanuda…).
OWNER_WHATSAPP_NUMBER=

# Números que el bot NUNCA contesta, ni texto ni archivos: equipo, guías,
# proveedores, el hotel. Coma-separados, solo dígitos.
NEVER_RESPOND_NUMBERS=

# A quién responde el bot:
#   strangers = desconocidos, y los contactos guardados con los que el bot ya
#               venía platicando (recomendado)
#   all       = a todos
RESPOND_MODE=strangers
# Números que SIEMPRE reciben respuesta aunque estén guardados (pruebas). Coma-separados.
# Si pones aquí el del dueño, el bot también te contesta como a un cliente.
ALWAYS_RESPOND_NUMBERS=

# Modelo. Haiku es el barato ($1 / $5 por millón de tokens) y es el que usamos.
# claude-sonnet-5 cuesta 3x más; solo vale la pena si el bot empieza a fallar
# en seguir el embudo.
BOT_MODEL=claude-haiku-4-5

# ESPERA POR RÁFAGA. El cliente manda varios mensajes seguidos; el bot espera a
# que deje de escribir y contesta UNA vez a todo junto.
#   MESSAGE_DEBOUNCE_MS     cada mensaje nuevo reinicia este reloj
#   MESSAGE_DEBOUNCE_MAX_MS tope duro desde el primer mensaje de la ráfaga
MESSAGE_DEBOUNCE_MS=15000
MESSAGE_DEBOUNCE_MAX_MS=90000

# PAUSAS (en milisegundos)
#   HUMAN_TAKEOVER_MS    cuando alguien del equipo escribe a mano en un chat, el
#                        bot se calla este rato (2 h); cada mensaje suyo lo
#                        vuelve a empezar. 🔴 Antes eran 5 min (300000): si en
#                        Railway sigue 300000, bórralo o ponle 7200000.
#                        🔴 La bienvenida y el mensaje de AUSENCIA de WhatsApp
#                        Business salen desde el mismo número: apágalos los
#                        dos (el bot ignora los que salen a segundos del
#                        cliente, pero uno lento lo callaría 2 h).
#   PAUSA_ESCALACION_MS  cuando el bot PASA un chat al equipo (pide llamada,
#                        para hoy…) y nadie escribe, retoma a las 12 h. Queja,
#                        cancelación, cliente molesto y cambios después de pagar
#                        esperan /reanuda.
HUMAN_TAKEOVER_MS=7200000
PAUSA_ESCALACION_MS=43200000

# Horario del equipo (hora de México). De aquí salen los tiempos que el bot le
# promete al cliente al pasarlo al equipo: «en unos minutos» en horario,
# «mañana desde las 8 am» fuera de él.
HORARIO_HUMANO=08:00-21:00

# Memoria del bot (conversaciones, pausas y comprobantes guardados). Tienen que
# vivir en el VOLUMEN persistente o se pierden en cada despliegue. Por omisión
# van dentro de .wwebjs_auth/, que ya es el volumen de Railway.
# ESTADO_PATH=./.wwebjs_auth/estado-bot.json
# COMPROBANTES_DIR=./.wwebjs_auth/comprobantes

# Cuánto se le espera al sitio antes de darlo por caído (ms).
# SITE_API_TIMEOUT_MS=45000

# Datos de pago que da el bot (transferencia + OXXO). Los mismos BANK_* van
# también en el servicio del sitio.
BANK_NAME=
BANK_TITULAR=
BANK_CLABE=
OXXO_REFERENCIA=

# Sitio del hotel, para consultar disponibilidad de habitaciones (solo lectura)
HOTEL_API_URL=https://www.paraisoencantado.com

# (Opcional, Railway/Docker) ruta a Chromium si no usas el de puppeteer
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
