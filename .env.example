# ── Stripe ────────────────────────────────────────────────────────────────────
# Claves en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# Webhook secret — genera con: stripe listen --forward-to localhost:3000/api/stripe-webhook
# O cópialo desde: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# ── App ────────────────────────────────────────────────────────────────────────
# URL pública del sitio (sin barra final)
APP_URL=https://tu-dominio.com

# ── Anthropic / Claude ────────────────────────────────────────────────────────
# Clave en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Sheets ──────────────────────────────────────────────────────────────
# ID del spreadsheet (en la URL de Google Sheets)
GOOGLE_SHEETS_ID=tu-spreadsheet-id
# Email del service account (Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_EMAIL=cuenta@proyecto.iam.gserviceaccount.com
# Private key del service account (con \n escapados)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ── Bot de WhatsApp (Tours Huasteca Potosina) ─────────────────────────────────
# Token compartido entre el sitio y el bot para autenticar /api/bot/*.
# Genera uno largo y aleatorio; debe ser IDÉNTICO en el bot (whatsapp-bot/.env).
AGENT_API_TOKEN=
# Datos bancarios para cotizaciones por transferencia que manda el bot
BANK_NAME=
BANK_TITULAR=
BANK_CLABE=
BANK_CUENTA=

# Google Analytics 4 — Measurement Protocol.
# Deja que el webhook de Stripe cuente la venta aunque el cliente cierre la
# pestaña, el pago quede en "processing" o un bloqueador tumbe gtag.
# Se crea en GA4 → Administrar → Flujos de datos → el flujo web →
# Measurement Protocol API secrets → Crear. Sin esta variable el envío no se
# hace y solo queda un aviso en el log: nada se rompe.
GA4_API_SECRET=
