# ── Stripe ────────────────────────────────────────────────────────────────────
# Claves en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# Webhook secret — genera con: stripe listen --forward-to localhost:3000/api/stripe-webhook
# O cópialo desde: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# ── App ────────────────────────────────────────────────────────────────────────
# URL pública del sitio (sin barra final)
APP_URL=https://tu-dominio.com

# ── Anthropic / Claude ────────────────────────────────────────────────────────
# Clave en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Sheets ──────────────────────────────────────────────────────────────
# ID del spreadsheet (en la URL de Google Sheets)
GOOGLE_SHEETS_ID=tu-spreadsheet-id
# Email del service account (Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_EMAIL=cuenta@proyecto.iam.gserviceaccount.com
# Private key del service account (con \n escapados)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ── Bot de WhatsApp (Tours Huasteca Potosina) ─────────────────────────────────
# Token compartido entre el sitio y el bot para autenticar /api/bot/*.
# Genera uno largo y aleatorio; debe ser IDÉNTICO en el bot (whatsapp-bot/.env).
AGENT_API_TOKEN=
# Datos bancarios para cotizaciones por transferencia que manda el bot
BANK_NAME=
BANK_TITULAR=
BANK_CLABE=
BANK_CUENTA=

# Google Analytics 4 — Measurement Protocol.
# Deja que el webhook de Stripe cuente la venta aunque el cliente cierre la
# pestaña, el pago quede en "processing" o un bloqueador tumbe gtag.
# Se crea en GA4 → Administrar → Flujos de datos → el flujo web →
# Measurement Protocol API secrets → Crear. Sin esta variable el envío no se
# hace y solo queda un aviso en el log: nada se rompe.
# «Metas → Fuentes» avisa si falta esta o NEXT_PUBLIC_GA4_ID (lote 9).
GA4_API_SECRET=
# El ID del flujo web de GA4 (el G-…): lo usan la página y el envío de compras de arriba.
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# Indicadores del panel (4 nov 2026): el panel LEE GA4 y Search Console con el
# robot de arriba (GOOGLE_SERVICE_ACCOUNT_EMAIL), que tiene rol «Lector» en GA4
# y «Restringido» en Search Console. Es el NÚMERO de la propiedad, no el G-….
GA4_PROPERTY_ID=545095004
# Opcional: la propiedad de Search Console (por omisión el dominio completo).
GSC_SITE=sc-domain:huasteca-potosina.com

# ── Panel de administración (quién entra a /admin) ────────────────────────────
# Firma de la sesión. Sin esta variable NADIE puede entrar (no hay fallback).
ADMIN_JWT_SECRET=
# Dueño (por defecto el usuario es "manolo"; cámbialo con ADMIN_USERNAME)
ADMIN_USERNAME=manolo
ADMIN_PASSWORD=
# Socio — ve todo menos el Curso IA. Usuario de login: martin
ADMIN_PASSWORD_MARTIN=
# Operación (WhatsApp y cierre de reservas) — no ve Ingresos ni Curso IA. Usuario: erick
ADMIN_PASSWORD_ERICK=
# Opcional: en vez de la contraseña en texto, su hash bcrypt (tiene prioridad).
# ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD_HASH_MARTIN=
# ADMIN_PASSWORD_HASH_ERICK=

# ── Correos del equipo (resúmenes, recordatorios y avisos) ────────────────────
# Buzones del equipo, separados por coma: avisos de ventas y, si alguien no
# tiene correo propio, su resumen y sus recordatorios.
ADMIN_EMAIL_TOURS=
# El correo propio de cada persona del panel (ADMIN_EMAIL_<USUARIO>): ahí le
# llega su resumen de las 7:30 y sus recordatorios. Sin él, va al buzón del
# equipo y «Metas → Fuentes» lo marca en amarillo (lote 9, 10 nov 2026).
ADMIN_EMAIL_MANOLO=
ADMIN_EMAIL_MARTIN=
ADMIN_EMAIL_ERICK=

# ── Tareas programadas ────────────────────────────────────────────────────────
# Llave de los /api/cron/* (si falta, se usa BLOG_AGENT_SECRET). El cron horario
# de GitHub también pasa a Operado los viajes ya pasados y da una vuelta del
# agente de los chats (lote 9).
CRON_SECRET=
# 0 = apaga el reloj interno del servidor (reglas, resumen de las 7:30,
# recordatorios, agente y reporte de los jueves); queda solo el cron horario.
RECORDATORIOS_INTERNOS=
